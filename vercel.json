{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/rollpuller", "destination": "/rp3xl", "permanent": true },
    { "source": "/rollpuller.html", "destination": "/rp3xl", "permanent": true },
    { "source": "/grizzly", "destination": "/rp3xl", "permanent": true },
    { "source": "/grizzly.html", "destination": "/rp3xl", "permanent": true },
    { "source": "/accessories", "destination": "/rp3xl", "permanent": true },
    { "source": "/accessories.html", "destination": "/rp3xl", "permanent": true },
    { "source": "/custom-equipment", "destination": "/rp3xl", "permanent": true },
    { "source": "/custom-equipment.html", "destination": "/rp3xl", "permanent": true },
    { "source": "/consulting", "destination": "/rp3xl", "permanent": true },
    { "source": "/consulting.html", "destination": "/rp3xl", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
